<?xml version="1.0"?>
<model>
  <name>livox_avia</name>
  <version>1.0</version>
  <sdf version="1.9">lidar_3d.sdf</sdf>

  <author>
    <name>Thais</name>
  </author>

  <description>
    Aproximação do sensor LiDAR Livox Avia (905nm, Classe 1 eye-safe,
    alcance 320-450m, FOV horizontal 70.4°, FOV vertical até 77.2°)
    para uso no módulo de percepção do TCC. O Gazebo não replica o
    padrão de varredura circular não-repetitivo real do Avia; os
    parâmetros aproximam alcance/FOV/densidade de pontos equivalente.
  </description>
</model>
