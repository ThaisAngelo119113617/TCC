<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="livox_avia">
    <static>false</static>
    <link name="lidar_3d">
      <inertial>
        <mass>0.498</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.0912 0.0612 0.0648</size>
          </box>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.0912 0.0612 0.0648</size>
          </box>
        </geometry>
      </collision>

      <sensor name="gpu_ray" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-0.61436</min_angle>
              <max_angle>0.61436</max_angle>
            </horizontal>
            <vertical>
              <samples>200</samples>
              <resolution>1</resolution>
              <min_angle>-0.6737</min_angle>
              <max_angle>0.6737</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>450.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>