<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="livox_avia">
    <static>false</static>
    <link name="lidar_3d">
      <sensor name="livox_rgl" type="custom">
        <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
          <range>
            <min>0.1</min>
            <max>450.0</max>
          </range>
          <update_rate>10</update_rate>
          <update_on_paused_sim>false</update_on_paused_sim>
          <topic>x500_px4/sensor_measurements/livox_avia/points</topic>
          <frame>livox_avia</frame>
          <pattern_preset>Livox Avia</pattern_preset>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>