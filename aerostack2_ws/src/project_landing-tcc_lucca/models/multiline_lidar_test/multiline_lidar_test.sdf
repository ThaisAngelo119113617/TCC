<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="multiline_lidar_test">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.498</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.0912 0.0612 0.0648</size>
          </box>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.0912 0.0612 0.0648</size>
          </box>
        </geometry>
      </collision>

      <!--
        TESTE: aproximação de LiDAR multi-linha (estilo Velodyne/Livox) usando
        N sensores gpu_lidar independentes, cada um SÓ com varredura horizontal
        (sem tag <vertical>), inclinados em pitches diferentes.

        Motivo: sensores gpu_lidar com <vertical> (varredura 2D/3D real) crasham
        de forma sistemática e reproduzível nesse ambiente (Gazebo Harmonic +
        Docker + NVIDIA), ver issues:
          https://github.com/gazebosim/gz-sensors/issues/370
          https://github.com/gazebosim/gz-sim/issues/2851
        Sensores só-horizontais (sem <vertical>) se mostraram estáveis em todos
        os testes. Este modelo empilha N deles para reconstituir uma nuvem 3D,
        de forma análoga a como LiDARs mecânicos multi-linha reais são
        construídos internamente (feixes laser empilhados).

        Nó de percepção deve assinar os N tópicos lidar/row_0..row_2,
        e somar o pitch conhecido de cada sensor (ver comentário <pose> de cada
        um) para reconstruir a nuvem de pontos 3D combinada.
      -->

      <sensor name="lidar_row_0" type="gpu_lidar">
        <pose>0 0 0 0 -0.67370 0</pose> <!-- pitch: -38.6 deg -->
        <topic>lidar/row_0</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>90</samples>
              <resolution>1</resolution>
              <min_angle>-0.61436</min_angle>
              <max_angle>0.61436</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>450.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
      <sensor name="lidar_row_1" type="gpu_lidar">
        <pose>0 0 0 0 0.00000 0</pose> <!-- pitch: 0.0 deg -->
        <topic>lidar/row_1</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>90</samples>
              <resolution>1</resolution>
              <min_angle>-0.61436</min_angle>
              <max_angle>0.61436</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>450.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
      <sensor name="lidar_row_2" type="gpu_lidar">
        <pose>0 0 0 0 0.67370 0</pose> <!-- pitch: 38.6 deg -->
        <topic>lidar/row_2</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>90</samples>
              <resolution>1</resolution>
              <min_angle>-0.61436</min_angle>
              <max_angle>0.61436</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>450.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>
