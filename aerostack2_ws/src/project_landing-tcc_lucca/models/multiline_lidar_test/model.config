<?xml version="1.0"?>
<model>
  <name>Multiline LiDAR Test</name>
  <version>1.0</version>
  <sdf version="1.9">multiline_lidar_test.sdf</sdf>
  <description>
    Modelo de teste: LiDAR multi-linha simulado com N sensores gpu_lidar
    só-horizontais empilhados em pitches diferentes, evitando a tag
    &lt;vertical&gt; que causa crash reprodutível no gz-sim Harmonic.
  </description>
</model>
