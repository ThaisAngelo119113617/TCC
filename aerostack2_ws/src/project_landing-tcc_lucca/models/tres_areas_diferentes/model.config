<?xml version="1.0"?>
<model>
  <name>tres_areas_diferentes</name>
  <version>1.0</version>
  <sdf version="1.9">tres_areas_diferentes.sdf</sdf>

  <author>
    <name>Thais</name>
  </author>

  <description>
    Heightmap com 3 zonas planas diferenciadas para validacao do pipeline
    de percepcao (TCC): Zona A (grande, lisa, longe da decolagem),
    Zona B (pequena, levemente rugosa, perto da decolagem), Zona C
    (rampa ~19 graus, deve ser rejeitada pelo filtro de inclinacao).
  </description>
</model>